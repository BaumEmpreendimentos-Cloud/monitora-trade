{
  "name": "CompartilhamentoOperacoes",
  "type": "object",
  "properties": {
    "titular_id": {
      "type": "string",
      "title": "ID do titular das opera\u00e7\u00f5es"
    },
    "titular_nome": {
      "type": "string",
      "title": "Nome do titular"
    },
    "visualizador_id": {
      "type": "string",
      "title": "ID do usu\u00e1rio autorizado"
    },
    "visualizador_nome": {
      "type": "string",
      "title": "Nome do usu\u00e1rio autorizado"
    },
    "visualizador_email": {
      "type": "string",
      "title": "E-mail do usu\u00e1rio autorizado"
    },
    "status": {
      "type": "string",
      "enum": [
        "AUTORIZADO",
        "REVOGADO"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "default": "AUTORIZADO",
      "title": "Status"
    },
    "data_autorizacao": {
      "type": "string",
      "format": "date-time",
      "title": "Data da autoriza\u00e7\u00e3o"
    }
  },
  "required": [
    "titular_id",
    "visualizador_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.visualizador_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}